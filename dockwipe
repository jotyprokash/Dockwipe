#!/usr/bin/env bash
# dockwipe - Docker cleanup & reset CLI
# License: MIT

set -euo pipefail

VERSION="1.3.0"

DRY_RUN=false
QUIET=false
NO_COLOR=false
YES=false
OLDER_THAN="${DOCKWIPE_OLDER_THAN:-}"
PRUNE_BUILD_CACHE=false
PRUNE_ANON_VOLUMES=false

# --------- UI helpers ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[1;35m'
CYAN='\033[1;36m'
NC='\033[0m'

_color() {
  if $NO_COLOR || [[ ! -t 1 ]]; then
    printf '%s' ""
  else
    printf '%b' "$1"
  fi
}

log()  { $QUIET || echo -e "$(_color "$BLUE")[dockwipe]$(_color "$NC") $*"; }
ok()   { $QUIET || echo -e "$(_color "$GREEN")[ok]$(_color "$NC") $*"; }
warn() { $QUIET || echo -e "$(_color "$YELLOW")[warn]$(_color "$NC") $*"; }
err()  { echo -e "$(_color "$RED")[error]$(_color "$NC") $*" 1>&2; }

have() { command -v "$1" >/dev/null 2>&1; }

run() {
  local cmd="$*"
  if $DRY_RUN; then
    echo "[dry-run] $cmd"
  else
    eval "$cmd"
  fi
}

run_args() {
  if $DRY_RUN; then
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

sudo_run() {
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    run "$*"
  else
    run "sudo $*"
  fi
}

confirm() {
  local allow_yes="${2:-false}"

  if $YES && $allow_yes; then
    return 0
  fi

  local prompt="${1:-This action is destructive. Continue?}"
  local ans=""
  read -r -p "$prompt (yes/no): " ans
  if [[ "$ans" != "yes" ]]; then
    warn "Aborted."
    exit 0
  fi
}

danger_confirm() {
  local phrase="$1"
  local detail="$2"

  if $YES; then
    err "--yes is disabled for danger commands."
    exit 1
  fi

  if $DRY_RUN; then
    warn "Danger dry-run: commands will be printed, not executed."
    return 0
  fi

  warn "$detail"
  warn "This is isolated under 'dockwipe danger' because it can disrupt services or delete Docker data."

  local ans=""
  read -r -p "Type '$phrase' to continue: " ans
  if [[ "$ans" != "$phrase" ]]; then
    warn "Aborted."
    exit 0
  fi
}

load_config() {
  local config="${DOCKWIPE_CONFIG:-/etc/dockwipe/config}"

  if [[ -f "$config" ]]; then
    # shellcheck source=/dev/null
    source "$config"
    OLDER_THAN="${OLDER_THAN:-${DEFAULT_OLDER_THAN:-}}"
    PRUNE_BUILD_CACHE="${DEFAULT_PRUNE_BUILD_CACHE:-$PRUNE_BUILD_CACHE}"
    PRUNE_ANON_VOLUMES="${DEFAULT_PRUNE_ANON_VOLUMES:-$PRUNE_ANON_VOLUMES}"
  fi
}

filter_args() {
  if [[ -n "$OLDER_THAN" ]]; then
    printf '%s\n' --filter "until=$OLDER_THAN"
  fi
}

print_retention() {
  if [[ -n "$OLDER_THAN" ]]; then
    log "Retention filter: resources older than $OLDER_THAN"
  else
    warn "No retention filter set; Docker will prune all unused resources in the selected categories."
  fi
}

print_banner() {
  $QUIET && return 0
  [[ -t 1 ]] || return 0

  echo -e "$(_color "$CYAN")"
  echo "██████╗  ██████╗  ██████╗██╗  ██╗██╗    ██╗██╗██████╗ ███████╗"
  echo "██╔══██╗██╔═══██╗██╔════╝██║ ██╔╝██║    ██║██║██╔══██╗██╔════╝"
  echo "██║  ██║██║   ██║██║     █████╔╝ ██║ █╗ ██║██║██████╔╝█████╗  "
  echo "██║  ██║██║   ██║██║     ██╔═██╗ ██║███╗██║██║██╔═══╝ ██╔══╝  "
  echo "██████╔╝╚██████╔╝╚██████╗██║  ██╗╚███╔███╔╝██║██║     ███████╗"
  echo "╚═════╝  ╚═════╝  ╚═════╝╚═╝  ╚═╝ ╚══╝╚══╝ ╚═╝╚═╝     ╚══════╝"
  echo -e "$(_color "$NC")"

  echo -e "$(_color "$GREEN")⚡ Docker Cleanup & Reset CLI$(_color "$NC")"
  echo -e "$(_color "$YELLOW")🚀 DevOps tool for keeping Docker environments clean$(_color "$NC")"
  echo

  echo -e "$(_color "$PURPLE")Version :$(_color "$NC") $VERSION"
  echo -e "$(_color "$PURPLE")Author  :$(_color "$NC") Joty Prokash Mondal"

  echo -e "$(_color "$BLUE")────────────────────────────────────────────────────$(_color "$NC")"
  echo
}

need_docker() {
  if ! have docker; then
    err "docker CLI not found. Install Docker first."
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    err "Docker daemon is not running (or you don't have permission)."
    err "Try: sudo systemctl start docker  (or add your user to the docker group)"
    exit 1
  fi
}

need_root_for_full() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]] && ! have sudo; then
    err "sudo not found. Run as root or install sudo."
    exit 1
  fi
}

is_systemd() {
  [[ -d /run/systemd/system ]] && have systemctl
}

stop_services() {
  if is_systemd; then
    log "Stopping Docker services (systemd)..."
    sudo_run systemctl stop docker || true
    sudo_run systemctl stop containerd || true
  else
    warn "systemd not detected. Attempting best-effort daemon stop..."
    sudo_run service docker stop || true
    sudo_run service containerd stop || true
    sudo_run pkill -f dockerd || true
    sudo_run pkill -f containerd || true
  fi
}

start_services() {
  if is_systemd; then
    log "Starting Docker services (systemd)..."
    sudo_run systemctl start containerd || true
    sudo_run systemctl start docker || true
  else
    warn "systemd not detected. Attempting best-effort daemon start..."
    sudo_run service containerd start || true
    sudo_run service docker start || true
  fi
}

cmd_status() {
  need_docker
  log "Docker disk usage:"
  docker system df || true
}

cmd_analyze() {
  need_docker
  log "Analyze: Docker disk usage summary"
  docker system df || true

  echo ""
  log "Analyze: Top images (first 15)"
  docker images --format '{{.Repository}}:{{.Tag}}\t{{.Size}}\t{{.ID}}' \
    | sort -hr -k2 2>/dev/null \
    | head -n 15 || true

  echo ""
  log "Analyze: Volumes (first 20 names)"
  docker volume ls || true
  echo ""
  docker volume ls -q | head -n 20 | sed 's/^/ - /' || true

  echo ""
  log "Analyze: Containers (running + exited)"
  docker ps -a || true

  echo ""
  log "Analyze: Docker directories size (best effort)"
  if have du; then
    for p in /var/lib/docker /var/lib/containerd; do
      if [[ -d "$p" ]]; then
        du -sh "$p" 2>/dev/null || true
        du -h --max-depth=1 "$p" 2>/dev/null | sort -hr | head -n 10 || true
      else
        warn "$p not found (ok on some systems)."
      fi
      echo ""
    done
  else
    warn "'du' not found; skipping directory sizing."
  fi

  ok "Analyze complete."
}

cmd_containers() {
  need_docker
  log "Removing all containers..."
  run "docker ps -aq | xargs -r docker rm -f"
  ok "Containers removed."
}

cmd_images() {
  need_docker
  log "Removing all images..."
  run "docker images -aq | xargs -r docker rmi -f"
  ok "Images removed."
}

cmd_volumes() {
  need_docker
  log "Removing all volumes..."
  run "docker volume ls -q | xargs -r docker volume rm"
  ok "Volumes removed."
}

cmd_networks() {
  need_docker
  log "Removing custom networks (keeping bridge/host/none)..."
  run "docker network ls --format '{{.Name}}' | grep -Ev '^(bridge|host|none)$' | xargs -r docker network rm"
  ok "Networks cleaned."
}

cmd_cache() {
  need_docker
  log "Removing Docker build cache..."
  run "docker builder prune -a -f || true"
  ok "Build cache cleaned."
}

cmd_plan() {
  need_docker
  print_retention

  echo ""
  log "Safe cleanup plan"
  echo "Dockwipe will keep running containers and Docker resources that are still in use."
  echo ""

  log "Will prune:"
  echo " - stopped containers selected by Docker prune"
  echo " - unused Docker networks selected by Docker prune"
  echo " - dangling images selected by Docker prune"
  echo " - unused images selected by Docker prune"
  if $PRUNE_BUILD_CACHE; then
    echo " - build cache selected by Docker builder prune"
  else
    echo " - build cache: skipped unless --include-build-cache is set"
  fi
  echo " - volumes: skipped by default"

  echo ""
  log "Currently protected by Docker state:"
  printf ' - running containers: '
  docker ps -q | wc -l | tr -d ' '
  printf ' - images used by containers are not removed by Docker prune while referenced\n'
  printf ' - mounted volumes are not removed by Docker prune while referenced\n'
  printf ' - networks attached to containers are not removed by Docker prune while referenced\n'

  echo ""
  log "Current Docker disk usage:"
  docker system df || true

  echo ""
  log "Preview commands:"
  if [[ -n "$OLDER_THAN" ]]; then
    echo " docker container prune -f --filter until=$OLDER_THAN"
    echo " docker network prune -f --filter until=$OLDER_THAN"
    echo " docker image prune -a -f --filter until=$OLDER_THAN"
    $PRUNE_BUILD_CACHE && echo " docker builder prune -a -f --filter until=$OLDER_THAN"
  else
    echo " docker container prune -f"
    echo " docker network prune -f"
    echo " docker image prune -a -f"
    $PRUNE_BUILD_CACHE && echo " docker builder prune -a -f"
  fi

  ok "Plan complete. Run dockwipe clean --yes to apply in automation."
}

cmd_safe() {
  if $PRUNE_ANON_VOLUMES; then
    err "Volume pruning is isolated under: dockwipe danger volumes"
    exit 1
  fi

  need_docker
  print_retention

  confirm "Safe cleanup removes unused Docker resources while keeping running services. Continue?" true

  local filters=()
  mapfile -t filters < <(filter_args)

  log "Pruning stopped containers..."
  run_args docker container prune -f "${filters[@]}" || true

  log "Pruning unused networks..."
  run_args docker network prune -f "${filters[@]}" || true

  log "Pruning unused images..."
  run_args docker image prune -a -f "${filters[@]}" || true

  if $PRUNE_BUILD_CACHE; then
    log "Pruning build cache..."
    run_args docker builder prune -a -f "${filters[@]}" || true
  else
    log "Skipping build cache. Use --include-build-cache to include it."
  fi

  log "Skipping volumes by default."

  echo ""
  log "Docker disk usage after safe cleanup:"
  docker system df || true
  ok "Safe cleanup complete."
}

cmd_smart() {
  danger_confirm "run smart prune" "Smart cleanup removes unused Docker objects and may remove resources needed for quick rebuilds."
  need_docker
  log "Running: docker system prune -f"
  run "docker system prune -f || true"
  log "Running: docker builder prune -f"
  run "docker builder prune -f || true"
  ok "Smart cleanup complete."
}

cmd_full() {
  danger_confirm "wipe docker" "Factory reset deletes Docker and containerd state from this host."
  need_root_for_full

  log "Factory reset starting..."

  if have docker && docker info >/dev/null 2>&1; then
    warn "Attempting Docker-level cleanup first (best effort)..."
    run "docker system prune -a --volumes -f || true"
    run "docker builder prune -a -f || true"
  else
    warn "Docker daemon not reachable; proceeding with filesystem reset."
  fi

  stop_services

  log "Wiping Docker + containerd state..."
  sudo_run rm -rf /var/lib/docker
  sudo_run rm -rf /var/lib/containerd
  sudo_run rm -rf /var/run/docker
  sudo_run rm -rf /var/run/containerd
  sudo_run rm -rf /run/docker
  sudo_run rm -rf /run/containerd

  log "Recreating required directories..."
  sudo_run mkdir -p /var/lib/docker
  sudo_run mkdir -p /var/lib/containerd

  start_services

  echo ""
  ok "Docker factory reset complete."
  echo ""
  docker system df || true
  echo ""
  log "Networks after reset (expect bridge/host/none only):"
  docker network ls || true
}

cmd_danger() {
  local danger_cmd="${1:-help}"

  case "$danger_cmd" in
    help|-h|--help)
      danger_usage
      ;;
    smart)
      cmd_smart
      ;;
    containers)
      danger_confirm "remove containers" "This removes all containers, including running containers."
      cmd_containers
      ;;
    images)
      danger_confirm "remove images" "This removes all Docker images and may break future restarts or rollbacks."
      cmd_images
      ;;
    volumes)
      danger_confirm "remove volumes" "This removes all Docker volumes and can delete persistent application data."
      cmd_volumes
      ;;
    networks)
      danger_confirm "remove networks" "This removes custom Docker networks and can break service connectivity."
      cmd_networks
      ;;
    cache)
      danger_confirm "remove cache" "This removes all Docker build cache."
      cmd_cache
      ;;
    full)
      cmd_full
      ;;
    *)
      danger_usage
      exit 1
      ;;
  esac
}

usage() {
  cat <<'EOF'
dockwipe - Docker cleanup & reset tool

Usage:
  dockwipe status
  dockwipe analyze
  dockwipe plan
  dockwipe clean
  dockwipe danger help

Global options:
  --older-than VALUE          Apply Docker prune retention filter, for example 7d or 24h
  --yes                      Do not prompt for safe automation runs
  --include-build-cache      Include build cache in safe cleanup
  --dry-run                  Print actions without executing
  --quiet                    Less output
  --no-color                 Disable ANSI colors
  --version                  Print version
  --help                     Show this help

Examples:
  dockwipe status
  dockwipe plan --older-than 7d
  dockwipe clean --older-than 7d --yes
EOF
}

danger_usage() {
  cat <<'EOF'
dockwipe danger - isolated admin operations

Usage:
  dockwipe danger smart
  dockwipe danger containers
  dockwipe danger images
  dockwipe danger volumes
  dockwipe danger networks
  dockwipe danger cache
  dockwipe danger full

Danger commands require an exact confirmation phrase and ignore --yes.
Do not run danger commands from cron.
EOF
}

load_config

if [[ $# -eq 0 ]]; then
  print_banner
  usage
  exit 0
fi

ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true ;;
    --quiet) QUIET=true ;;
    --no-color) NO_COLOR=true ;;
    --yes|-y) YES=true ;;
    --older-than)
      if [[ $# -lt 2 || "$2" == --* ]]; then
        err "--older-than requires a value, for example 7d or 24h."
        exit 1
      fi
      OLDER_THAN="$2"
      shift
      ;;
    --older-than=*)
      OLDER_THAN="${1#*=}"
      if [[ -z "$OLDER_THAN" ]]; then
        err "--older-than requires a value, for example 7d or 24h."
        exit 1
      fi
      ;;
    --include-build-cache|--prune-build-cache) PRUNE_BUILD_CACHE=true ;;
    --prune-anonymous-volumes) PRUNE_ANON_VOLUMES=true ;;
    --help|-h) print_banner; usage; exit 0 ;;
    --version) echo "dockwipe v$VERSION"; exit 0 ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done

print_banner

cmd="${ARGS[0]:-}"
case "$cmd" in
  help)              usage ;;
  version)           echo "dockwipe v$VERSION" ;;
  status|--status)   cmd_status ;;
  analyze|--analyze) cmd_analyze ;;
  plan|--plan)       cmd_plan ;;
  clean|safe|--safe) cmd_safe ;;
  danger)            cmd_danger "${ARGS[1]:-help}" ;;
  --smart)           warn "--smart is deprecated. Use: dockwipe danger smart"; cmd_danger smart ;;
  --containers)      warn "--containers is deprecated. Use: dockwipe danger containers"; cmd_danger containers ;;
  --images)          warn "--images is deprecated. Use: dockwipe danger images"; cmd_danger images ;;
  --volumes)         warn "--volumes is deprecated. Use: dockwipe danger volumes"; cmd_danger volumes ;;
  --networks)        warn "--networks is deprecated. Use: dockwipe danger networks"; cmd_danger networks ;;
  --cache)           warn "--cache is deprecated. Use: dockwipe danger cache"; cmd_danger cache ;;
  --full)            warn "--full is deprecated. Use: dockwipe danger full"; cmd_danger full ;;
  *) usage; exit 1 ;;
esac
